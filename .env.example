# Copy to .env locally and load it using your preferred environment loader.
# Never put real credentials in this tracked example file.
PORT=5000
HOST=127.0.0.1
SKY_DATABASE_PATH=data/skysentinel.sqlite3
SKY_EVIDENCE_DIR=evidence

# Existing drone-only YOLO11n weights (default paths are repository-root best.pt/best1.pt).
SKY_CLOSE_MODEL=best.pt
SKY_CLOSE_MODEL_ENABLED=true
SKY_CLOSE_CONFIDENCE=0.25
SKY_CLOSE_IMAGE_SIZE=640
SKY_LONG_MODEL=best1.pt
SKY_LONG_MODEL_ENABLED=true
SKY_LONG_CONFIDENCE=0.25
SKY_LONG_IMAGE_SIZE=640
SKY_FRAME_TYPE=visible_rgb
SKY_MERGE_IOU=0.55
SKY_ENCOUNTER_TIMEOUT=30
SKY_ALERT_THRESHOLD=60
SKY_ALERT_COOLDOWN=300
SKY_HARDWARE_COMMAND_COOLDOWN=3
SKY_RISK_CONFIDENCE_POINTS=20
SKY_RISK_PERSISTENCE_UNDER_2=0
SKY_RISK_PERSISTENCE_2_TO_5=5
SKY_RISK_PERSISTENCE_5_TO_15=12
SKY_RISK_PERSISTENCE_15_TO_30=18
SKY_RISK_PERSISTENCE_OVER_30=25
SKY_RISK_PROXIMITY_FAR=5
SKY_RISK_PROXIMITY_MEDIUM=15
SKY_RISK_PROXIMITY_NEAR=30
SKY_RISK_MOTION_POINTS=15
SKY_RISK_SENSOR_POINTS=10
SKY_RISK_MEDIUM_THRESHOLD=30
SKY_RISK_HIGH_THRESHOLD=60

# Firebase is optional. Set GOOGLE_APPLICATION_CREDENTIALS to a local, untracked key path
# or configure Application Default Credentials; never paste key JSON into this file.
SKY_FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
SKY_FIREBASE_POLL_SECONDS=5

# Configure a strong random token before connecting the ESP32.
SKY_SENSOR_TOKEN=
SKY_SENSOR_SIMULATION=false
